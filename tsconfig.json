{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    // Bundler mode (pour Vite)
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    // Mode strict progressif
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Paths pour vos imports
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/ai/*": ["./src/ai/*"],
    },
    
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx", 
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "backup"
  ]
}

