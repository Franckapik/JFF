@startuml "Bot FSM Improved Diagram"

title "Bot FSM - Modèle Amélioré avec Actions Prioritaires"

' Définition du style
skinparam state {
  BackgroundColor<<central>> Gold
  BackgroundColor<<active>> LightGreen
  BackgroundColor<<priority>> LightBlue
  BorderColor Black
  FontSize 14
}

skinparam arrow {
  FontSize 12
  Color Black
}

' État IDLE comme contrôleur central
state "IDLE" as IDLE <<central>> {
  state "Queue d'Actions Prioritaires" as PRIORITY_QUEUE <<priority>> {
    state "URGENT (P4)" as P4
    state "HIGH (P3)" as P3
    state "MEDIUM (P2)" as P2
    state "LOW (P1)" as P1
    
    P4 --> P3 : Si vide
    P3 --> P2 : Si vide
    P2 --> P1 : Si vide
  }
  
  state "Évaluation des Conditions" as EVAL
  
  PRIORITY_QUEUE --> EVAL : Si queue vide
}

' États actifs
state "EXPLORING" as EXPLORING <<active>> {
  state "Explorer avec drone" as DRONE_EXPLORE
  state "Déplacement aléatoire" as RANDOM_MOVE
  
  DRONE_EXPLORE --> RANDOM_MOVE : Si nécessaire
}

state "COLLECTING" as COLLECTING <<active>> {
  state "Navigation vers ressource" as MOVE_TO_RESOURCE
  state "Collecte de ressource" as COLLECT
  
  MOVE_TO_RESOURCE --> COLLECT : Arrivé à destination
}

state "RETURNING" as RETURNING <<active>> {
  state "Navigation vers base" as MOVE_TO_BASE
  state "Ravitaillement" as REFUEL
  
  MOVE_TO_BASE --> REFUEL : Arrivé à la base
}

' Transitions entre états majeurs
IDLE --> EXPLORING : Aucune ressource connue\ncarburant suffisant
IDLE --> COLLECTING : Ressources connues disponibles\ncarburant suffisant
IDLE --> RETURNING : Carburant faible\nou capacité maximale atteinte

' Toutes les actions retournent à l'état IDLE
EXPLORING --> IDLE : Action terminée
COLLECTING --> IDLE : Action terminée
RETURNING --> IDLE : Action terminée

' Événements qui peuvent interrompre le flux normal
EXPLORING -[#red]-> IDLE : Découverte de ressource\n[Ajoute action dans queue]

' Notes explicatives pour la nouvelle architecture
note bottom of PRIORITY_QUEUE
  File d'actions par priorité:
  1. Chaque état peut ajouter des actions
  2. Les actions sont exécutées par ordre de priorité
  3. Permet l'interruption et la reprise d'actions
end note

note right of IDLE
  Avantages de l'architecture centralisée:
  1. Centralisation de la prise de décision
  2. Simplification des transitions entre états
  3. Flexibilité pour ajouter de nouveaux comportements
  4. Réactivité aux changements d'environnement
end note

' Légende
legend right
  **Architecture FSM Améliorée**
  
  Ce modèle intègre une file d'actions prioritaires
  qui permet une meilleure gestion des interruptions
  et des comportements émergents.
  
  Tous les états retournent à IDLE comme point central
  pour la prise de décision.
endlegend

@enduml