{
  "name": "react-three-vite",
  "version": "1.0.2",
  "description": "A simple React Three Fiber + Vite starter with an import-ready CodeSandbox config.",
  "keywords": [
    "r3f",
    "react",
    "three",
    "vite",
    "starter",
    "react three fiber",
    "sandbox",
    "codesandbox"
  ],
  "author": "Benjamin Miles <talk@benjaminmiles.com> (https://github.com/benjaminmiles)",
  "repository": "github:benjaminmiles/react-three-vite",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.5.0",
    "@react-three/fiber": "^9.2.0",
    "@statelyai/inspect": "^0.4.0",
    "@xstate/react": "^6.0.0",
    "fast-deep-equal": "^3.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-robot": "^1.2.0",
    "robot3": "^1.1.1",
    "three": "^0.178.0",
    "xstate": "^5.20.2",
    "zukeeper": "^1.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.30.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "inquirer": "^9.3.8",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.10",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "test": "node scripts/menu.js",
    "dev": "vite",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "type-watch": "tsc --noEmit --watch",
    "preview": "vite preview",
    "validate-guards": "node scripts/test-guards-interactive.js",
    "quick-test-guards": "node scripts/quick-test-guards.js",
    "test:fsm-cycle": "node scripts/test-fsm-cycle.js",
    "test:fsm-quick": "node scripts/test-fsm-cycle.js --scenario=quick",
    "test:fsm-explore": "node scripts/test-fsm-cycle.js --scenario=explore",
    "test:fsm-collect": "node scripts/test-fsm-cycle.js --scenario=collect",
    "test:fsm-maintain": "node scripts/test-fsm-cycle.js --scenario=maintain",
    "test:fsm-verbose": "node scripts/test-fsm-cycle.js --verbose"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "type": "module"
}
