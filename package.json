{
  "name": "react-three-vite",
  "version": "1.0.2",
  "description": "A simple React Three Fiber + Vite starter with an import-ready CodeSandbox config.",
  "keywords": [
    "r3f",
    "react",
    "three",
    "vite",
    "starter",
    "react three fiber",
    "sandbox",
    "codesandbox"
  ],
  "author": "Benjamin Miles <talk@benjaminmiles.com> (https://github.com/benjaminmiles)",
  "repository": "github:benjaminmiles/react-three-vite",
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/drei": "^10.5.0",
    "@react-three/fiber": "^9.2.0",
    "@react-three/rapier": "^2.2.0",
    "@statelyai/inspect": "^0.7.2",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0",
    "xstate": "^5.20.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.178.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "inquirer": "^9.3.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "log:server": "node scripts/log-server.mjs",
    "dev:all": "npm-run-all -p log:server dev",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "type-watch": "tsc --noEmit --watch",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 src/AppRouter.tsx src/components/GameInitializer.tsx src/components/session src/stores/useSessionStore.ts src/workers/session-worker.ts src/engine/session*.ts src/engine/resources.ts src/engine/world.ts src/engine/rules.ts src/engine/model.ts src/engine/botMachine.ts src/engine/protocol.ts",
    "validate": "npm run type-check && npm test && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "type": "module"
}
